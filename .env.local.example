# SharePoint REST API URLs (required for Sessions, Speakers, Sponsors)
# Format: https://{tenant}.sharepoint.com/sites/{site}/_api/web/lists/GetByTitle('{list-name}')/items
VITE_SHAREPOINT_SESSIONS_URL=https://andworx.sharepoint.com/sites/M365CommunityDaysDC2026/_api/web/lists/GetByTitle('M365 Community Days DC 2026 Sessions')/items
VITE_SHAREPOINT_SPEAKERS_URL=https://andworx.sharepoint.com/sites/M365CommunityDaysDC2026/_api/web/lists/GetByTitle('M365 Community Days DC 2026 Speakers')/items
VITE_SHAREPOINT_SPONSORS_URL=https://andworx.sharepoint.com/sites/M365CommunityDaysDC2026/_api/web/lists/GetByTitle('M365 Community Days DC 2026 Sponsors')/items

# Azure AD Configuration for MSAL OAuth 2.0 sign-in
# Register an app at https://portal.azure.com under App Registrations
# CRITICAL: Add Redirect URI in Authentication settings:
#   Development: http://localhost:3000
#   Production: https://yourdomain.com

# Application (client) ID from Azure AD App registration
VITE_AZURE_AD_CLIENT_ID=your-client-id-here

# Tenant ID (usually a UUID like 12345678-1234-5678-abcd-123456789abc)
# Or use "common" for multi-tenant
VITE_AZURE_AD_TENANT_ID=your-tenant-id-here