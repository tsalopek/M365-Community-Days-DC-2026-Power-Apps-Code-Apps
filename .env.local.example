# NextAuth.js Configuration
# Get a random secret: `openssl rand -base64 32` or visit https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=your_random_secret_here_use_32_char_minimum

# Your app URL (change for production)
NEXTAUTH_URL=http://localhost:3000

# Azure AD Configuration
# Register an app at https://portal.azure.com under Azure Active Directory > App registrations
# CRITICAL: In the app's Authentication page, add this as a Web Redirect URI:
#   http://localhost:3000/api/auth/callback/azure-ad
# If you skip this step, you'll get "AADSTS500113: No reply address is registered" error

# Application (client) ID from Azure AD App registration
AZURE_AD_CLIENT_ID=your_azure_ad_client_id_here

# Client secret created in Azure AD App registration > Certificates & secrets
# Copy the VALUE, not the Secret ID
AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret_here

# Tenant ID (usually a UUID like 12345678-1234-5678-abcd-123456789abc)
# Or use "common" for multi-tenant
AZURE_AD_TENANT_ID=common

# SharePoint Sessions List URL
SHAREPOINT_SESSIONS_URL=https://yourtenant.sharepoint.com/sites/YourSite/_api/web/lists/GetByTitle('Your%20Sessions%20List')/items

# SharePoint Speakers List URL
SHAREPOINT_SPEAKERS_URL=https://yourtenant.sharepoint.com/sites/YourSite/_api/web/lists/GetByTitle('Your%20Speakers%20List')/items

# SharePoint Sponsors List URL
SHAREPOINT_SPONSORS_URL=https://yourtenant.sharepoint.com/sites/YourSite/_api/web/lists/GetByTitle('Your%20Sponsors%20List')/items
